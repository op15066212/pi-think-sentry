{
  "lang": "zh",
  "inject": {
    "on": true,
    "texts": {
      "dup": "\n[第 {{blockLine}} 行起重复 {{blockReps}} 次，已折叠]",
      "lang": "\n[{{lines}} 行不是中文，已改]",
      "clean": "",
      "inline": ""
    }
  },
  "dup": {
    "on": true,
    "min": 4
  },
  "strip": {
    "on": true,
    "min": 4
  },
  "binding": {
    "allowGateway": true
  },
  "intercept": {
    "on": true
  },
  "inline": {
    "on": true,
    "min": 12,
    "ratio": 0.25
  }
}
